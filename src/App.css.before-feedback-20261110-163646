}

.notification-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 2px 2px 12px;
  border-bottom: 1px solid var(--line);
}

.notification-heading button {
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 21px;
}

.notification-entry {
  display: flex;
  gap: 10px;
  padding: 12px 2px;
  border-bottom: 1px solid var(--line);
}

.notification-entry:last-child { border-bottom: 0; }
.notification-entry-icon {
  flex: 0 0 30px;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 10px;
