}

.task-filter.active {
  border-color: rgba(118,85,233,.4);
  background: rgba(118,85,233,.10);
  color: var(--violet);
  box-shadow: 0 3px 9px rgba(118,85,233,.10);
}

.notification-wrap {
  position: relative;
}

.notification-button {
  width: 40px;
  height: 40px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: var(--surface);
  color: var(--text);
  font-size: 20px;
  box-shadow: var(--depth-shadow);
  position: relative;
}

.notification-dot {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 8px;
  height: 8px;
  border: 2px solid var(--surface);
  border-radius: 50%;
  background: #ef8b48;
}

.notification-popover {
  position: absolute;
  z-index: 50;
  top: 50px;
  right: 0;
