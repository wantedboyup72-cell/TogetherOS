  .workspace-progress-icon.purple { background: #eee9ff; color: #8067ed; }
  .workspace-progress-icon.blue { background: #e6f0ff; color: #5488d9; }
  .workspace-progress-icon.orange { background: #fff0e2; color: #df9850; }

  .workspace-progress-info {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: 5px;
  }

  .workspace-progress-name {
    overflow: hidden;
    color: var(--text-primary, #28233a);
    font-size: 13px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .workspace-progress-meta {
    color: var(--text-muted, #89849a);
    font-size: 11px;
  }

  .workspace-progress-track {
    height: 6px;
    margin-top: 3px;
  }

  .workspace-progress-fill.purple { background: #8067ed; }
  .workspace-progress-fill.blue { background: #5488d9; }
  .workspace-progress-fill.orange { background: #df9850; }

  .workspace-progress-percent {
    min-width: 42px;
    color: var(--text-primary, #28233a);
    font-size: 13px;
    text-align: right;
  }

  .dark .analytics-panel {
    border-color: rgba(180, 165, 220, .12);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .16);
  }

  .dark .completion-donut-inner {
    background: var(--panel-bg, #211d2d);
  }

  .dark .workspace-progress-icon.purple { background: rgba(128, 103, 237, .18); }
  .dark .workspace-progress-icon.blue { background: rgba(84, 136, 217, .18); }
  .dark .workspace-progress-icon.orange { background: rgba(223, 152, 80, .18); }
}

@media (prefers-reduced-motion: reduce) {
  .analytics-panel, .workspace-progress-row,
  .priority-fill, .workspace-progress-fill {
    transition: none !important;
  }
}

 
