/* TOGETHEROS PREMIUM MOTION UPGRADE */

:root {
  --premium-ease: cubic-bezier(.2,.75,.25,1);
  --premium-shadow: 0 12px 30px rgba(48,35,91,.09);
  --premium-glow: 0 8px 24px rgba(119,83,235,.17);
}

/* Brand: dimensional logo */
.brand-button {
  perspective: 700px;
  transform: translateZ(0);
  transition: transform .25s var(--premium-ease),
              opacity .25s ease;
}

.brand-button:hover {
  transform: translateY(-2px);
}

.brand-mark {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  transform-style: preserve-3d;
  box-shadow:
    0 5px 0 rgba(71,45,151,.18),
    0 9px 18px rgba(105,75,220,.25),
    inset 0 1px 1px rgba(255,255,255,.65);
  transition: transform .3s var(--premium-ease),
              box-shadow .3s ease;
}

.brand-mark::before {
  content: "";
  position: absolute;
  inset: -60% auto -60% -45%;
  width: 45%;
  background: linear-gradient(90deg,transparent,rgba(255,255,255,.42),transparent);
  transform: rotate(25deg);
  transition: left .65s ease;
  z-index: -1;
}

.brand-button:hover .brand-mark {
  transform: rotateY(-12deg) rotateX(8deg) translateY(-2px);
  box-shadow:
    0 7px 0 rgba(71,45,151,.16),
    0 14px 25px rgba(105,75,220,.3),
    inset 0 1px 2px rgba(255,255,255,.7);
}

.brand-button:hover .brand-mark::before {
  left: 125%;
}

/* Sidebar depth */
.sidebar {
  position: relative;
  isolation: isolate;
}

.sidebar::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 1px;
  height: 100%;
  background: linear-gradient(180deg,transparent,var(--line),transparent);
  pointer-events: none;
}

.nav-item {
  position: relative;
  overflow: hidden;
  transform: translateZ(0);
  transition: transform .22s var(--premium-ease),
              background .22s ease,
              box-shadow .22s ease,
              color .22s ease;
}

.nav-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 3px;
  border-radius: 0 5px 5px 0;
  background: var(--violet);
  transform: scaleY(0);
  transition: transform .22s var(--premium-ease);
}

.nav-item:hover {
  transform: translateX(3px);
  box-shadow: 0 5px 14px rgba(55,42,90,.055);
}

.nav-item.active::before {
  transform: scaleY(1);
}

.nav-icon {
  transition: transform .25s var(--premium-ease);
}

.nav-item:hover .nav-icon {
  transform: translateY(-2px) scale(1.08);
}

/* Workspace switcher: elevated card */
.workspace-switcher {
  position: relative;
  transform: translateZ(0);
  transition: transform .25s var(--premium-ease),
              box-shadow .25s ease,
              border-color .25s ease;
}

button.workspace-switcher {
  font: inherit;
  color: var(--text);
  cursor: pointer;
  text-align: left;
}

.workspace-switcher:hover {
  transform: translateY(-3px);
  box-shadow: var(--premium-shadow), var(--premium-glow);
  border-color: rgba(125,94,235,.3);
}

.switcher-avatar {
  box-shadow:
    0 4px 0 rgba(117,85,220,.1),
    0 7px 14px rgba(117,85,220,.13),
    inset 0 1px 2px rgba(255,255,255,.8);
  transition: transform .25s var(--premium-ease);
}

.workspace-switcher:hover .switcher-avatar {
  transform: rotate(-6deg) translateY(-2px);
}

.switcher-arrow {
  transition: transform .25s ease;
}

.workspace-switcher[aria-expanded="true"] .switcher-arrow {
  transform: rotate(180deg);
}

/* Workspace dropdown */
.workspace-switcher-menu,
.workspace-menu {
  animation: premiumMenuIn .22s var(--premium-ease) both;
  transform-origin: top center;
  box-shadow: 0 18px 45px rgba(35,25,70,.16);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.workspace-switcher-menu button,
.workspace-menu button {
  transition: background .18s ease,
              transform .18s var(--premium-ease);
}

.workspace-switcher-menu button:hover,
.workspace-menu button:hover {
  transform: translateX(3px);
}

/* Workspace list */
.workspace-link {
  transition: transform .2s var(--premium-ease),
              background .2s ease,
              box-shadow .2s ease;
}

.workspace-link:hover {
  transform: translateX(4px);
  box-shadow: 0 4px 12px rgba(45,35,80,.06);
}

.workspace-link.selected {
  background: rgba(125,94,235,.10);
  box-shadow: inset 3px 0 var(--violet);
}

.workspace-dot {
  box-shadow: 0 0 0 3px rgba(125,94,235,.08);
  transition: transform .2s ease;
}

.workspace-link:hover .workspace-dot {
  transform: scale(1.25);
}

/* Buttons: subtle physical press */
button {
  -webkit-tap-highlight-color: transparent;
}

button:not(:disabled) {
  transition:
    transform .2s var(--premium-ease),
    box-shadow .2s ease,
    background-color .2s ease,
    border-color .2s ease;
}

button:not(:disabled):active {
  transform: translateY(1px) scale(.985);
}

/* Profile menu */
.profile-popover {
  transform-origin: top right;
  animation: premiumMenuIn .2s var(--premium-ease) both;
  box-shadow: 0 18px 45px rgba(35,25,70,.16);
}

.profile-popover button {
  transition: background .18s ease, padding-left .18s ease;
}

.profile-popover button:hover {
  padding-left: 17px;
}

/* Smooth page entrance */
.main-content {
  animation: premiumPageIn .3s var(--premium-ease) both;
}

@keyframes premiumMenuIn {
  from { opacity: 0; transform: translateY(-8px) scale(.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes premiumPageIn {
  from { opacity: .65; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Dark mode polish */
.dark-mode .workspace-switcher:hover,
.dark .workspace-switcher:hover {
  box-shadow: 0 12px 28px rgba(0,0,0,.24), 0 0 20px rgba(135,105,255,.10);
}

.dark-mode .nav-item:hover,
.dark .nav-item:hover {
  box-shadow: 0 5px 14px rgba(0,0,0,.16);
}

/* Respect accessibility and low-power devices */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}

@media (max-width: 760px) {
  .nav-item:hover,
  .workspace-link:hover {
    transform: none;
  }
}

